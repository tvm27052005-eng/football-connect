# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string (Cloud Atlas or Local).
# Example Cloud: mongodb+srv://username:password@cluster0.mongodb.net/football-connect?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/football-connect
MONGODB_URI="mongodb://127.0.0.1:27017/football-connect"

# CLOUDINARY CONFIGURATION (Multer + Cloudinary Image Storage)
# Lấy miễn phí tại https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
