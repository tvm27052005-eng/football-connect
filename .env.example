# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Assistant: knowledge mode works without an AI key. To enable AI, set gemini
# and an available model ID for your Google AI account (server only).
AI_PROVIDER="knowledge"
AI_MODEL=""
AI_TIMEOUT_MS="15000"
AI_SYSTEM_PROMPT="Friendly, concise and professional."

# APP_URL: the public URL where this app is hosted.
APP_URL="MY_APP_URL"

# MongoDB (local or MongoDB Atlas)
MONGODB_URI="mongodb://127.0.0.1:27017/football-connect"

# Automatic bank payments: one payOS channel per venue owner, server secrets only.
# Use the actual owner user ID as JSON key. Do not expose these keys via VITE_*.
PAYOS_CHANNELS_JSON='{}'
# Example shape (replace every placeholder before use):
# PAYOS_CHANNELS_JSON='{"owner_user_id":{"clientId":"...","apiKey":"...","checksumKey":"..."}}'
PAYMENT_HOLD_MINUTES="15"
BOOKING_CANCEL_BEFORE_HOURS="2"
# Optional: override the key used to encrypt owner payOS secrets at rest.
PAYOS_CREDENTIAL_SECRET=""

# Email / OTP (server only; never commit real credentials)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USER="your-email@example.com"
MAIL_PASS="your-app-password"
MAIL_FROM="your-email@example.com"

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
