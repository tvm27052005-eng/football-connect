# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Assistant: knowledge mode works without an API key. To enable AI, set gemini
# and an available model ID for your Google AI account (server only).
AI_PROVIDER="knowledge"
AI_MODEL=""
AI_TIMEOUT_MS="15000"
AI_SYSTEM_PROMPT="Friendly, concise and professional."
# Set only a verified support mailbox; blank disables email handoff.
SUPPORT_EMAIL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string (Cloud Atlas or Local).
# Example Cloud: mongodb+srv://username:password@cluster0.mongodb.net/football-connect?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/football-connect
MONGODB_URI="mongodb://127.0.0.1:27017/football-connect"

# CLOUDINARY CONFIGURATION (Multer + Cloudinary Image Storage)
# Lấy miễn phí tại https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
